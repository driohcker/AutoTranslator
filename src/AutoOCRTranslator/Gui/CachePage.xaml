<Page x:Class="AutoOCRTranslator.Gui.CachePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="缓存" FontFamily="{StaticResource AppFontFamily}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 数据卡：方案管理 + 总条目（紧凑单行） -->
        <ui:Card Grid.Row="1" Margin="42,8,42,8" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 方案选择器：切换/新建/重命名/删除 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="方案" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="ProfileCombo" Width="240" SelectedValuePath="Tag"
                              SelectionChanged="ProfileCombo_Changed" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <ui:Button x:Name="NewProfileButton" Content="新建" Icon="{ui:SymbolIcon Add24}"
                               Margin="0,0,8,0" Click="NewProfileButton_Click" />
                    <ui:Button x:Name="RenameProfileButton" Content="重命名" Icon="{ui:SymbolIcon Edit24}"
                               Margin="0,0,8,0" Click="RenameProfileButton_Click" />
                    <ui:Button x:Name="DeleteProfileButton" Content="删除方案" Icon="{ui:SymbolIcon Delete24}"
                               Appearance="Caution" Click="DeleteProfileButton_Click" />
                </StackPanel>
                <!-- 总条目 -->
                <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="共" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TotalCountValue" Text="—" FontSize="18" FontWeight="SemiBold"
                               Margin="6,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <TextBlock Text="条" FontSize="13" Margin="3,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 操作卡：筛选 + 增删导入导出 -->
        <ui:Card Grid.Row="2" Margin="42,0,42,8" Padding="20,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="源语言" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="SourceLangFilter" Width="120" SelectedValuePath="Tag"
                              SelectionChanged="Filter_Changed" VerticalAlignment="Center">
                        <ComboBoxItem Content="全部" Tag="" IsSelected="True" />
                        <ComboBoxItem Content="日语" Tag="ja" />
                        <ComboBoxItem Content="英语" Tag="en" />
                        <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                        <ComboBoxItem Content="繁体中文" Tag="zh-TW" />
                    </ComboBox>
                    <TextBlock Text="目标语言" VerticalAlignment="Center" Margin="16,0,8,0" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="TargetLangFilter" Width="120" SelectedValuePath="Tag"
                              SelectionChanged="Filter_Changed" VerticalAlignment="Center">
                        <ComboBoxItem Content="全部" Tag="" IsSelected="True" />
                        <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                        <ComboBoxItem Content="繁体中文" Tag="zh-TW" />
                        <ComboBoxItem Content="英语" Tag="en" />
                        <ComboBoxItem Content="日语" Tag="ja" />
                    </ComboBox>
                    <TextBlock Text="搜索" VerticalAlignment="Center" Margin="16,0,8,0" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox x:Name="SearchBox" Width="220" PlaceholderText="源文本或译文"
                                TextChanged="Search_Changed" VerticalAlignment="Center" />
                    <ui:Button x:Name="RefreshButton" Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}"
                               Margin="16,0,0,0" Click="RefreshButton_Click" VerticalAlignment="Center" />
                </StackPanel>
                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal">
                    <ui:Button x:Name="ExportButton" Content="导出当前方案" Icon="{ui:SymbolIcon ArrowExportUp24}"
                               Margin="0,0,8,0" Click="ExportButton_Click" />
                    <ui:Button x:Name="ExportFilteredButton" Content="导出当前筛选"
                               Icon="{ui:SymbolIcon ArrowExportUp24}" Margin="0,0,8,0"
                               Click="ExportFilteredButton_Click" />
                    <ui:Button x:Name="ImportButton" Content="导入到当前方案" Icon="{ui:SymbolIcon ArrowExportUp24}"
                               Margin="0,0,8,0" Click="ImportButton_Click" />
                    <ui:Button x:Name="DeleteSelectedButton" Content="删除选中"
                               Icon="{ui:SymbolIcon Delete24}" Margin="0,0,8,0"
                               Click="DeleteSelectedButton_Click" />
                    <ui:Button x:Name="ClearAllButton" Content="清空当前方案" Icon="{ui:SymbolIcon Eraser24}"
                               Appearance="Caution" Click="ClearAllButton_Click" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <!-- 显示区：数据栏卡片 + 独立分页按钮 -->
        <Grid Grid.Row="3" Margin="42,0,42,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- 数据栏：仅 DataGrid，按钮不再包裹在内 -->
            <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <DataGrid x:Name="EntriesGrid"
                         AutoGenerateColumns="False" IsReadOnly="True"
                         HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                         BorderThickness="0" Background="Transparent"
                         CanUserSortColumns="False" SelectionMode="Extended"
                         ColumnHeaderHeight="34" RowHeight="30">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="选" Binding="{Binding IsSelected}" Width="36" />
                        <DataGridTextColumn Header="源文本" Binding="{Binding SourceText}" Width="*" />
                        <DataGridTextColumn Header="译文" Binding="{Binding Translation}" Width="*" />
                        <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="90" />
                        <DataGridTextColumn Header="命中" Binding="{Binding HitCount}" Width="50" />
                        <DataGridTextColumn Header="最后访问" Binding="{Binding LastAccessed}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <!-- 分页按钮：独立于数据卡片之外，无线条包裹 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <ui:Button x:Name="PrevButton" Content="上一页" Click="PrevButton_Click" Margin="0,0,8,0" />
                <TextBlock x:Name="PageInfo" Text="0 / 0" VerticalAlignment="Center" Margin="8,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ui:Button x:Name="NextButton" Content="下一页" Click="NextButton_Click" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- 缓存未启用遮罩 -->
        <Border x:Name="DisabledOverlay" Grid.Row="0" Grid.RowSpan="4"
                Background="{DynamicResource ApplicationBackgroundBrush}" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Database24" Width="48" Height="48"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="翻译缓存未启用" FontSize="16" Margin="0,12,0,4" HorizontalAlignment="Center" />
                <TextBlock Text="请在设置 → 缓存中开启「启用翻译缓存」后重启"
                           FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Page>

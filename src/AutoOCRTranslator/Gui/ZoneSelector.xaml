<Window x:Class="AutoOCRTranslator.Gui.ZoneSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None" AllowsTransparency="True" Topmost="True"
        ShowInTaskbar="False" ShowActivated="True" ResizeMode="NoResize"
        Background="Transparent"
        Title="划分翻译区域"
        FontFamily="{StaticResource AppFontFamily}"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- 次要按钮：半透明深色，圆角，hover 提亮 -->
        <Style x:Key="ZoneButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#99202020" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CC383838" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E6101010" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（完成）：Windows 强调蓝 -->
        <Style x:Key="ZonePrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF0067C0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#66000000" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1975C8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF005AAD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 半透明蒙版：底下画面保持可见，同时让区域边框清晰 -->
        <Rectangle Fill="#40000000" />

        <!-- 全屏拖拽画布：与虚拟屏幕同尺寸同位置（代码中设置） -->
        <Canvas x:Name="DrawCanvas" Background="Transparent" MouseLeftButtonDown="Canvas_MouseDown"
                MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseUp" />

        <!-- 主屏锚定容器：提示与按钮相对主屏排布，避免多显示器时落在副屏或屏间找不到 -->
        <!-- Grid 不设 Background（默认 null）不拦截鼠标，让拖拽穿透到下方 Canvas；尺寸与位置在代码中按 WorkArea 设置 -->
        <Grid x:Name="PrimaryAnchor" HorizontalAlignment="Left" VerticalAlignment="Top">
            <!-- 底部提示（相对主屏水平居中；不拦截鼠标） -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"
                    Background="#CC202020" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10"
                    Padding="18,10" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Cursor24" Foreground="White" Margin="0,0,8,0" />
                    <TextBlock Text="在蒙版上拖拽框选翻译区域（相对目标窗口）  |  Enter 完成  |  Esc 取消"
                               Foreground="White" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 右下角操作按钮组（相对主屏右下，WorkArea 已扣除任务栏） -->
            <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,24,16">
                <Button x:Name="UndoButton" Content="撤销" Margin="8,0,0,0" Padding="20,9"
                        Click="UndoButton_Click" Style="{StaticResource ZoneButtonStyle}" />
                <Button x:Name="ClearButton" Content="清空" Margin="8,0,0,0" Padding="20,9"
                        Click="ClearButton_Click" Style="{StaticResource ZoneButtonStyle}" />
                <Button x:Name="CancelButton" Content="取消" Margin="8,0,0,0" Padding="20,9"
                        Click="CancelButton_Click" Style="{StaticResource ZoneButtonStyle}" />
                <Button x:Name="DoneButton" Content="完成" Margin="8,0,0,0" Padding="26,9"
                        Click="DoneButton_Click" Style="{StaticResource ZonePrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
